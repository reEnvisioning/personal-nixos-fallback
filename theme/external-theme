#!/usr/bin/env bash
set -uo pipefail

APP_DIR="$HOME/.config/reEnvisioning/active/apps"
THEME_FILE="$HOME/.config/reEnvisioning/active/theme.json"
MODE="$(jq -r '.mode // "dark"' "$THEME_FILE" 2>/dev/null || echo dark)"

value() {
    file="$1"
    key="$2"
    fallback="$3"
    [ -f "$file" ] || { printf '%s\n' "$fallback"; return; }
    awk -F' = ' -v key="$key" -v fallback="$fallback" '
        $1 == key { gsub(/^"|"$/, "", $2); print $2; found=1; exit }
        END { if (!found) print fallback }
    ' "$file" 2>/dev/null
}

bool() {
    [ "$(value "$1" "$2" "$3")" = "true" ]
}

# LocalSend
LS_FILE="$APP_DIR/localsend_app.toml"
LS_COLOR="$(value "$LS_FILE" color system)"
LOCALSEND_PREFS="$HOME/.local/share/org.localsend.localsend_app/shared_preferences.json"
mkdir -p "$(dirname "$LOCALSEND_PREFS")"
tmp="$(mktemp)"
if [ -s "$LOCALSEND_PREFS" ]; then
    jq --arg mode "$MODE" --arg color "$LS_COLOR" \
        '. + {"flutter.ls_theme": $mode, "flutter.ls_color": $color}' \
        "$LOCALSEND_PREFS" > "$tmp" 2>/dev/null || \
        printf '{"flutter.ls_theme":"%s","flutter.ls_color":"%s"}\n' "$MODE" "$LS_COLOR" > "$tmp"
else
    printf '{"flutter.ls_theme":"%s","flutter.ls_color":"%s"}\n' "$MODE" "$LS_COLOR" > "$tmp"
fi
mv "$tmp" "$LOCALSEND_PREFS"
pkill localsend 2>/dev/null || true

# GTK
GTK_FILE="$APP_DIR/gtk.toml"
GTK_THEME_NAME="$(value "$GTK_FILE" theme "")"
if [ -n "$GTK_THEME_NAME" ]; then
    gsettings set org.gnome.desktop.interface gtk-theme "$GTK_THEME_NAME" 2>/dev/null || true
fi
if bool "$GTK_FILE" prefer_dark false; then
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true
    PREFER_DARK=1
else
    gsettings set org.gnome.desktop.interface color-scheme 'default' 2>/dev/null || true
    PREFER_DARK=0
fi
for ver in 3.0 4.0; do
    ini="$HOME/.config/gtk-$ver/settings.ini"
    mkdir -p "$(dirname "$ini")"
    printf "[Settings]\ngtk-theme-name=%s\ngtk-application-prefer-dark-theme=%d\n" "$GTK_THEME_NAME" "$PREFER_DARK" > "$ini"
done

# Qt
QT_STYLE="$(value "$APP_DIR/qt.toml" style Adwaita)"
for qtver in qt5ct qt6ct; do
    conf_dir="$HOME/.config/$qtver"
    mkdir -p "$conf_dir"
    cat > "$conf_dir/$qtver.conf" << EOF
[Appearance]
color_scheme_path=
custom_palette=false
icon_theme=Adwaita
style=$QT_STYLE
EOF
done

# Kdenlive
KDENLIVE_RC="$HOME/.config/kdenliverc"
mkdir -p "$(dirname "$KDENLIVE_RC")"
KDE_SCHEME="$(value "$APP_DIR/kdenlive.toml" scheme BreezeDark)"
KDE_WIDGET_STYLE="$(value "$APP_DIR/kdenlive.toml" widget_style Fusion)"
if grep -q '^widgetStyle=' "$KDENLIVE_RC" 2>/dev/null; then
    sed -i 's|^widgetStyle=.*|widgetStyle='"$KDE_WIDGET_STYLE"'|' "$KDENLIVE_RC"
else
    printf '\n[KDE]\nwidgetStyle=%s\n' "$KDE_WIDGET_STYLE" >> "$KDENLIVE_RC"
fi
if grep -q '^\[UiSettings\]' "$KDENLIVE_RC" 2>/dev/null; then
    sed -i '/^\[UiSettings\]/,/^\[/ s|^ColorScheme=.*|ColorScheme='"$KDE_SCHEME"'|' "$KDENLIVE_RC"
    sed -i '/^\[UiSettings\]/,/^\[/ s|^ColorSchemePath=.*|ColorSchemePath='"$KDE_SCHEME"'.colors|' "$KDENLIVE_RC"
else
    printf '\n[UiSettings]\nColorScheme=%s\nColorSchemePath=%s.colors\n' "$KDE_SCHEME" "$KDE_SCHEME" >> "$KDENLIVE_RC"
fi

# OBS
OBS_STYLE="$(value "$APP_DIR/obs.toml" style Acri)"
obs_ini="$HOME/.config/obs-studio/user.ini"
if [ -f "$obs_ini" ]; then
    obs_theme="com.obsproject.Yami.$OBS_STYLE"
    if grep -q '^Theme=' "$obs_ini" 2>/dev/null; then
        sed -i 's|^Theme=.*|Theme='"$obs_theme"'|' "$obs_ini"
    else
        printf '\n[Appearance]\nTheme=%s\n' "$obs_theme" >> "$obs_ini"
    fi
fi

# GIMP
pkill gimp 2>/dev/null || true
GIMP_THEME="$(value "$APP_DIR/gimp.toml" theme Default)"
GIMP_SCHEME="$(value "$APP_DIR/gimp.toml" color_scheme dark)"
gimp_dir="$HOME/.config/GIMP/3.0"
gimprc="$gimp_dir/gimprc"
mkdir -p "$gimp_dir"
grep -q '(theme ' "$gimprc" 2>/dev/null && sed -i 's|(theme .*)|(theme "'"$GIMP_THEME"'")|' "$gimprc" || echo "(theme \"$GIMP_THEME\")" >> "$gimprc"
grep -q '(theme-color-scheme ' "$gimprc" 2>/dev/null && sed -i 's|(theme-color-scheme .*)|(theme-color-scheme '"$GIMP_SCHEME"')|' "$gimprc" || echo "(theme-color-scheme $GIMP_SCHEME)" >> "$gimprc"

# Firefox / LibreWolf
set_browser_dark() {
    app_file="$1"
    root_dir="$2"
    bool "$app_file" dark_mode false && val=1 || val=0
    grep '^Path=' "$root_dir/profiles.ini" 2>/dev/null | cut -d= -f2 | while read -r profile; do
        userjs="$root_dir/$profile/user.js"
        [ -n "$profile" ] && [ -d "$root_dir/$profile" ] || continue
        if ! touch "$userjs" 2>/dev/null; then
            rm -f "$userjs" 2>/dev/null || continue
            : > "$userjs" 2>/dev/null || continue
        fi
        for pref in ui.systemUsesDarkTheme browser.theme.toolbar-theme browser.theme.content-theme; do
            line="user_pref(\"$pref\", $val);"
            if grep -q "^user_pref(\"$pref\"," "$userjs" 2>/dev/null; then
                sed -i "s|^user_pref(\"$pref\", .*|$line|" "$userjs"
            else
                echo "$line" >> "$userjs"
            fi
        done
    done
}
set_browser_dark "$APP_DIR/firefox.toml" "${XDG_CONFIG_HOME:-$HOME/.config}/mozilla/firefox"
LW_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/librewolf"
[ -f "$LW_DIR/profiles.ini" ] || LW_DIR="$HOME/.librewolf"
set_browser_dark "$APP_DIR/librewolf.toml" "$LW_DIR"
