#!/usr/bin/env bash
set -uo pipefail

THEME_NAME="${1:-}"
if [ -z "$THEME_NAME" ]; then
    echo "Usage: switch-theme <name>"
    exit 1
fi

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
SYS_THEME_DIR="/etc/headspace/themes"
USER_THEME_DIR="$HOME/.config/headspace/themes"
if [ -f "$USER_THEME_DIR/$THEME_NAME.json" ]; then
    THEME_DIR="$USER_THEME_DIR"
else
    THEME_DIR="$SYS_THEME_DIR"
fi
THEME_FILE="$THEME_DIR/$THEME_NAME.json"
SYS_YAZI_THEMES="/etc/headspace/yazi-themes"
USER_YAZI_THEMES="$HOME/.config/headspace/yazi-themes"
LOCALSEND_PREFS="$HOME/.local/share/org.localsend.localsend_app/shared_preferences.json"

if [ ! -f "$THEME_FILE" ]; then
    echo "Theme '$THEME_NAME' not found at $THEME_FILE"
    echo "Available themes:"
    ls "$SYS_THEME_DIR"/*.json "$USER_THEME_DIR"/*.json 2>/dev/null | xargs -n1 basename -s .json | sort -u
    exit 1
fi

MODE=$(jq -r '.mode' "$THEME_FILE")
WALLPAPER=$(jq -r '.wallpaper' "$THEME_FILE")
LS_COLOR=$(jq -r '.localsend_color' "$THEME_FILE")
OBS_STYLE=$(jq -r '.obs_style' "$THEME_FILE")
KDE_WIDGET_STYLE=$(jq -r '.KDEwidgetStyle // "Default"' "$THEME_FILE")
GTK_THEME_NAME=$(jq -r '.gtkThemeName // empty' "$THEME_FILE")

# 1. Wallpaper — wait for hyprpaper IPC to be ready
sleep 1
if [ -f "$WALLPAPER" ]; then
    hyprctl hyprpaper preload "$WALLPAPER" 2>/dev/null || true
    hyprctl hyprpaper wallpaper ",$WALLPAPER" 2>/dev/null || true
fi

# 2. Yazi theme — break Nix symlink, copy
mkdir -p "$HOME/.config/yazi"
rm -f "$HOME/.config/yazi/theme.toml"
YAZI_SRC="$USER_YAZI_THEMES/$THEME_NAME.toml"
[ ! -f "$YAZI_SRC" ] && YAZI_SRC="$SYS_YAZI_THEMES/$THEME_NAME.toml"
if [ -f "$YAZI_SRC" ]; then
    cp "$YAZI_SRC" "$HOME/.config/yazi/theme.toml"
fi

# 3. Kitty — break Nix symlink, write config, reload
KITTY_CONF="$HOME/.config/kitty/kitty.conf"
mkdir -p "$(dirname "$KITTY_CONF")"
rm -f "$KITTY_CONF"
jq -r '
  .colors as $c |
  "background \($c.background)",
  "foreground \($c.text)",
  "cursor \($c.text)",
  "selection_background \($c.highlighted)",
  "selection_foreground \($c.background)",
  "color0 \($c.background)",
  "color8 \($c.backgroundAccent)",
  "color1 \($c.red)",
  "color9 \($c.red)",
  "color2 \($c.green)",
  "color10 \($c.green)",
  "color3 \($c.yellow)",
  "color11 \($c.yellow)",
  "color4 \($c.blue)",
  "color12 \($c.blue)",
  "color5 \($c.magenta)",
  "color13 \($c.magenta)",
  "color6 \($c.cyan)",
  "color14 \($c.cyan)",
  "color7 \($c.text)",
  "color15 \($c.background)",
  "font_family Monospace",
  "font_size 10",
  "confirm_os_window_close 0"
' "$THEME_FILE" > "$KITTY_CONF"
pkill -SIGUSR1 kitty 2>/dev/null || true

# 5. LocalSend — write prefs, restart
mkdir -p "$(dirname "$LOCALSEND_PREFS")"
cat > "$LOCALSEND_PREFS" << EOF
{"flutter.ls_theme":"$MODE","flutter.ls_color":"$LS_COLOR"}
EOF
pkill localsend 2>/dev/null || true

# 6. GTK theme + dark/light mode — gsettings + overwrite settings.ini + copy GTK4 assets

# Find GTK theme directory
find_gtk_theme_dir() {
    local theme_name="$1"
    local dir
    for dir in \
        "/run/current-system/sw/share/themes/$theme_name" \
        "$HOME/.nix-profile/share/themes/$theme_name" \
        "/usr/share/themes/$theme_name"; do
        if [ -d "$dir" ]; then
            echo "$dir"
            return 0
        fi
    done
    return 1
}

# Set GTK theme via gsettings if available
if [ -n "$GTK_THEME_NAME" ]; then
    gsettings set org.gnome.desktop.interface gtk-theme "$GTK_THEME_NAME" 2>/dev/null || true
fi

# Set color-scheme for dark/light mode
if [ "$MODE" = "dark" ]; then
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true
    PREFER_DARK=1
else
    gsettings set org.gnome.desktop.interface color-scheme 'default' 2>/dev/null || true
    PREFER_DARK=0
fi

# Write settings.ini for GTK3 and GTK4
for ver in 3.0 4.0; do
    ini="$HOME/.config/gtk-$ver/settings.ini"
    mkdir -p "$(dirname "$ini")"
    rm -f "$ini"
    if [ -n "$GTK_THEME_NAME" ]; then
        printf "[Settings]\ngtk-theme-name=%s\ngtk-application-prefer-dark-theme=%d\n" "$GTK_THEME_NAME" "$PREFER_DARK" > "$ini"
    else
        printf "[Settings]\ngtk-application-prefer-dark-theme=%d\n" "$PREFER_DARK" > "$ini"
    fi
done

# Copy GTK4 assets (break Nix symlink, copy theme CSS/assets for libadwaita theming)
if [ -n "$GTK_THEME_NAME" ]; then
    GTK_THEME_DIR=$(find_gtk_theme_dir "$GTK_THEME_NAME")
    if [ -n "$GTK_THEME_DIR" ] && [ -d "$GTK_THEME_DIR/gtk-4.0" ]; then
        GTK4_DIR="$HOME/.config/gtk-4.0"
        mkdir -p "$GTK4_DIR"
        rm -f "$GTK4_DIR/gtk.css" "$GTK4_DIR/gtk-dark.css"
        rm -rf "$GTK4_DIR/assets"
        if [ -f "$GTK_THEME_DIR/gtk-4.0/gtk.css" ]; then
            cp "$GTK_THEME_DIR/gtk-4.0/gtk.css" "$GTK4_DIR/"
        fi
        if [ -f "$GTK_THEME_DIR/gtk-4.0/gtk-dark.css" ]; then
            cp "$GTK_THEME_DIR/gtk-4.0/gtk-dark.css" "$GTK4_DIR/"
        fi
        if [ -d "$GTK_THEME_DIR/gtk-4.0/assets" ]; then
            cp -r "$GTK_THEME_DIR/gtk-4.0/assets" "$GTK4_DIR/"
        fi
    fi
fi
for qtver in qt5ct qt6ct; do
    conf_dir="$HOME/.config/$qtver"
    mkdir -p "$conf_dir"
    if [ "$MODE" = "dark" ]; then
        qt_style="adwaita-dark"
    else
        qt_style="Adwaita"
    fi
    cat > "$conf_dir/$qtver.conf" << EOF
[Appearance]
color_scheme_path=
custom_palette=false
icon_theme=Adwaita
style=$qt_style
EOF
done

# 10. Kdenlive — color scheme + widget style
KDENLIVE_RC="$HOME/.config/kdenliverc"
mkdir -p "$(dirname "$KDENLIVE_RC")"
if [ "$MODE" = "dark" ]; then
    SCHEME="BreezeDark"
    SCHEME_PATH="BreezeDark.colors"
else
    SCHEME="BreezeLight"
    SCHEME_PATH="BreezeLight.colors"
fi

# [KDE] section — widget style (skip if "Default")
if [ "$KDE_WIDGET_STYLE" != "Default" ]; then
    if grep -q '^widgetStyle=' "$KDENLIVE_RC" 2>/dev/null; then
        sed -i 's|^widgetStyle=.*|widgetStyle='"$KDE_WIDGET_STYLE"'|' "$KDENLIVE_RC"
    elif grep -q '^\[KDE\]' "$KDENLIVE_RC" 2>/dev/null; then
        sed -i '/^\[KDE\]/a widgetStyle='"$KDE_WIDGET_STYLE" "$KDENLIVE_RC"
    else
        printf '\n[KDE]\nwidgetStyle=%s\n' "$KDE_WIDGET_STYLE" >> "$KDENLIVE_RC"
    fi
else
    sed -i '/^widgetStyle=/d' "$KDENLIVE_RC"
fi

# [UiSettings] section — color scheme
if grep -q '^\[UiSettings\]' "$KDENLIVE_RC" 2>/dev/null; then
    sed -i '/^\[UiSettings\]/,/^\[/ s|^ColorScheme=.*|ColorScheme='"$SCHEME"'|' "$KDENLIVE_RC"
    sed -i '/^\[UiSettings\]/,/^\[/ s|^ColorSchemePath=.*|ColorSchemePath='"$SCHEME_PATH"'|' "$KDENLIVE_RC"
else
    printf '\n[UiSettings]\nColorScheme=%s\nColorSchemePath=%s\n' "$SCHEME" "$SCHEME_PATH" >> "$KDENLIVE_RC"
fi

# OBS Studio — set theme
obs_ini="$HOME/.config/obs-studio/user.ini"
if [ -f "$obs_ini" ]; then
    obs_theme="com.obsproject.Yami.$OBS_STYLE"
    if grep -q '^Theme=' "$obs_ini" 2>/dev/null; then
        sed -i 's|^Theme=.*|Theme='"$obs_theme"'|' "$obs_ini"
    else
        if grep -q '^\[Appearance\]' "$obs_ini" 2>/dev/null; then
            sed -i '/^\[Appearance\]/a Theme='"$obs_theme" "$obs_ini"
        else
            printf '\n[Appearance]\nTheme=%s\n' "$obs_theme" >> "$obs_ini"
        fi
    fi
fi

# 7. Hyprland border colors
BORDER_FOCUSED=$(jq -r '.colors.borderFocused' "$THEME_FILE" | sed 's/^#//')
BORDER_INACTIVE=$(jq -r '.colors.borderInactive' "$THEME_FILE" | sed 's/^#//')
hyprctl keyword general:col.active_border "0xff$BORDER_FOCUSED" 2>/dev/null || true
hyprctl keyword general:col.inactive_border "0xff$BORDER_INACTIVE" 2>/dev/null || true

# 8. Quickshell — write startup notification + colors, then restart
printf "Theme Indicator\nTheme\nSwitched to %s\n" "$THEME_NAME" > "$RUNTIME_DIR/headspace-startup-notif"
jq -c '{name} + {mode} + .colors' "$THEME_FILE" > "$RUNTIME_DIR/headspace-colors.json"
pkill quickshell 2>/dev/null || true
sleep 0.2
nohup quickshell >/dev/null 2>&1 & disown

# 9. Save current theme + reset wallpaper index
state set current-theme "$THEME_NAME"
state set wallpaper-idx 0

# 11. GIMP 3.0 — set theme + color scheme, restart to pick up
pkill gimp 2>/dev/null || true
sleep 0.2

gimp_dir="$HOME/.config/GIMP/3.0"
gimprc="$gimp_dir/gimprc"
mkdir -p "$gimp_dir"

if [ "$MODE" = "dark" ]; then
    theme_line='(theme "Default")'
    scheme_line='(theme-color-scheme dark)'
else
    theme_line='(theme "Default")'
    scheme_line='(theme-color-scheme light)'
fi

if grep -q '(theme ' "$gimprc" 2>/dev/null; then
    sed -i 's|(theme .*)|'"$theme_line"'|' "$gimprc"
else
    echo "$theme_line" >> "$gimprc"
fi

if grep -q '(theme-color-scheme ' "$gimprc" 2>/dev/null; then
    sed -i 's|(theme-color-scheme .*)|'"$scheme_line"'|' "$gimprc"
else
    echo "$scheme_line" >> "$gimprc"
fi

# 12. Firefox — update theme prefs in-place, preserving Nix-managed prefs
FF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/mozilla/firefox"
grep '^Path=' "$FF_DIR/profiles.ini" 2>/dev/null | cut -d= -f2 | while read -r profile; do
    userjs="$FF_DIR/$profile/user.js"
    if [ -z "$profile" ] || [ ! -d "$FF_DIR/$profile" ]; then
        continue
    fi
    nix_content=$(cat "$userjs" 2>/dev/null || true)
    rm -f "$userjs"
    [ -n "$nix_content" ] && printf '%s\n' "$nix_content" > "$userjs"
    if [ "$MODE" = "dark" ]; then val=1; else val=0; fi
    for pref in \
        "ui.systemUsesDarkTheme" \
        "browser.theme.toolbar-theme" \
        "browser.theme.content-theme"; do
        line="user_pref(\"$pref\", $val);"
        if grep -q "^user_pref(\"$pref\"," "$userjs" 2>/dev/null; then
            sed -i "s|^user_pref(\"$pref\", .*|$line|" "$userjs"
        else
            echo "$line" >> "$userjs"
        fi
    done
done
