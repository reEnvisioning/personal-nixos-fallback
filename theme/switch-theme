#!/usr/bin/env bash
set -uo pipefail

THEME_NAME="${1:-}"
if [ -z "$THEME_NAME" ]; then
    echo "Usage: switch-theme <name>"
    exit 1
fi

ROOT="$HOME/.config/reEnvisioning"
THEME_DIR="$ROOT/themes"
ACTIVE_DIR="$ROOT/active"
THEME_FILE="$THEME_DIR/$THEME_NAME/theme.json"
RUNTIME_FILE="$ACTIVE_DIR/theme.json"

if [ ! -f "$THEME_FILE" ]; then
    echo "Theme '$THEME_NAME' not found at $THEME_FILE"
    echo "Available themes:"
    ls -d "$THEME_DIR"/*/ 2>/dev/null | xargs -n1 basename | sort -u
    exit 1
fi

extract_content() {
    awk '
        /^text = """$/ { in_content = 1; next }
        in_content && /^"""$/ { exit }
        in_content { print }
    ' "$1"
}

# 1. Update active theme view and app entries.
rm -rf "$ACTIVE_DIR/apps"
mkdir -p "$ACTIVE_DIR/apps"
ln -sfn "../themes/$THEME_NAME" "$ACTIVE_DIR/theme"
printf '%s' "$THEME_NAME" > "$ACTIVE_DIR/current-theme"
cp "$THEME_DIR/$THEME_NAME/apps/"*.toml "$ACTIVE_DIR/apps/" 2>/dev/null || true

# Render static-file app themes for apps that do not read runtime colors.
for app_conf in \
    "kitty.toml:$HOME/.config/kitty/kitty.conf" \
    "btop.toml:$HOME/.config/btop/themes/current.theme" \
    "yazi.toml:$HOME/.config/yazi/theme.toml"; do
    source="$ACTIVE_DIR/apps/${app_conf%%:*}"
    target="${app_conf##*:}"
    [ -f "$source" ] || continue
    mkdir -p "$(dirname "$target")"
    rm -f "$target"
    extract_content "$source" > "$target"
done

# 2. Write runtime theme.json (triggers systemd path → theme-reload → signals kitty/btop)
cp "$THEME_FILE" "$RUNTIME_FILE"

# 3. Wallpaper — per-theme index with bounds check
WALLPAPER_COUNT=$(jq '.wallpapers | length' "$THEME_FILE")
SAVED_IDX="$(state get wallpaper-idx:$THEME_NAME || echo "")"

if [ -z "$SAVED_IDX" ] || [ "$SAVED_IDX" -ge "$WALLPAPER_COUNT" ] 2>/dev/null; then
    WALLPAPER_IDX=0
else
    WALLPAPER_IDX=$((SAVED_IDX))
fi

WALLPAPER=$(jq -r ".wallpapers[$WALLPAPER_IDX]" "$THEME_FILE")

sleep 1
if [ -f "$WALLPAPER" ]; then
    pkill swaybg 2>/dev/null || true
    nohup swaybg -i "$WALLPAPER" -m fill >/dev/null 2>&1 & disown
    printf 'theme = "%s"\nindex = %s\npath = "%s"\n' "$THEME_NAME" "$WALLPAPER_IDX" "$WALLPAPER" > "$ACTIVE_DIR/wallpaper.toml"
fi

# 6. Third-party apps (GTK, Firefox, OBS, etc.)
command -v external-theme >/dev/null 2>&1 && external-theme

# 7. Notification
notify-send --app-name="Theme Indicator" --expire-time=2000 "Theme" "$THEME_NAME"
