#!/bin/sh
# Usage: volume up|down|toggle|set <value>

CMD="${1:-up}"

case "$CMD" in
    up)     pactl set-sink-volume @DEFAULT_SINK@ +5% ;;
    down)   pactl set-sink-volume @DEFAULT_SINK@ -5% ;;
    toggle) pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
    set)    pactl set-sink-volume @DEFAULT_SINK@ "${2:-50}%" ;;
esac

VOL=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -Po '\d+(?=%)' | head -1)
MUTED=$(pactl get-sink-mute @DEFAULT_SINK@ | grep -Po 'yes|no')

if [ "$MUTED" = "yes" ]; then
    notify-send --app-name="Volume Indicator" --expire-time=2000 "Volume" "Muted"
else
    notify-send --app-name="Volume Indicator" --expire-time=2000 "Volume" "${VOL}%"
fi
