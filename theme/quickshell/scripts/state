#!/bin/sh
# Usage: state get <key>   -> prints value or empty
#        state set <key> <value>   -> upserts

FILE="$HOME/.config/headspace/state"
CMD="$1"; KEY="$2"; VALUE="$3"

case "$CMD" in
    get)
        [ -f "$FILE" ] || exit 0
        sed -n "s/^$KEY=//p" "$FILE" | tail -1 ;;
    set)
        mkdir -p "$(dirname "$FILE")"
        if grep -q "^$KEY=" "$FILE" 2>/dev/null; then
            sed -i "s|^$KEY=.*|$KEY=$VALUE|" "$FILE"
        else
            echo "$KEY=$VALUE" >> "$FILE"
        fi ;;
esac
