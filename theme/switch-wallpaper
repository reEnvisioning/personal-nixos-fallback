#!/usr/bin/env bash
set -uo pipefail

ROOT="$HOME/.config/reEnvisioning"
THEME_DIR="$ROOT/themes"
ACTIVE_DIR="$ROOT/active"

THEME_NAME="$(cat "$ACTIVE_DIR/current-theme" 2>/dev/null || true)"
if [ -z "$THEME_NAME" ]; then
    echo "No current theme set. Use retheme switch first."
    exit 1
fi

WALLPAPER_FILE="$THEME_DIR/$THEME_NAME/wallpapers.toml"

if [ ! -f "$WALLPAPER_FILE" ]; then
    echo "Theme '$THEME_NAME' has no wallpapers at $WALLPAPER_FILE"
    exit 1
fi

WALLPAPER_COUNT=$(awk '/^\[\[wallpaper\]\]/ { count++ } END { print count + 0 }' "$WALLPAPER_FILE")
if [ "$WALLPAPER_COUNT" -eq 0 ]; then
    echo "No wallpapers available for theme '$THEME_NAME'"
    exit 1
fi

SAVED_THEME="$(awk -F' = ' '$1 == "theme" { gsub(/^"|"$/, "", $2); print $2; exit }' "$ACTIVE_DIR/wallpaper.toml" 2>/dev/null || true)"
SAVED_IDX="$(awk -F' = ' '$1 == "index" { print $2; exit }' "$ACTIVE_DIR/wallpaper.toml" 2>/dev/null || true)"

if [ "$SAVED_THEME" != "$THEME_NAME" ]; then
    CURRENT_IDX=0
else
    case "$SAVED_IDX" in
        ''|*[!0-9]*) CURRENT_IDX=0 ;;
        *)
            if [ "$SAVED_IDX" -ge "$WALLPAPER_COUNT" ]; then
                CURRENT_IDX=0
            else
                CURRENT_IDX=$SAVED_IDX
            fi
            ;;
    esac
fi

case "${1:-restore}" in
    restore)
        NEW_IDX=$CURRENT_IDX
        ;;
    next)
        NEW_IDX=$(((CURRENT_IDX + 1) % WALLPAPER_COUNT))
        ;;
    prev)
        NEW_IDX=$(((CURRENT_IDX - 1 + WALLPAPER_COUNT) % WALLPAPER_COUNT))
        ;;
    *)
        if [[ "$1" =~ ^[0-9]+$ ]] && [ "$1" -lt "$WALLPAPER_COUNT" ]; then
            NEW_IDX=$1
        else
            echo "Usage: switch-wallpaper [next|prev|INDEX]"
            echo "Available wallpapers for '$THEME_NAME': 0-$((WALLPAPER_COUNT - 1))"
            exit 1
        fi
        ;;
esac

WALLPAPER=$(awk -F' = ' -v idx="$NEW_IDX" '
    /^\[\[wallpaper\]\]/ { current++ }
    current == idx + 1 && $1 == "path" { gsub(/^"|"$/, "", $2); print $2; exit }
' "$WALLPAPER_FILE")
case "$WALLPAPER" in
    /*) ;;
    *) WALLPAPER="$THEME_DIR/$THEME_NAME/$WALLPAPER" ;;
esac

sleep 0.2
if [ -f "$WALLPAPER" ]; then
    pkill swaybg 2>/dev/null || true
    nohup swaybg -i "$WALLPAPER" -m fill >/dev/null 2>&1 & disown
    mkdir -p "$ACTIVE_DIR"
    printf 'theme = "%s"\nindex = %s\npath = "%s"\n' "$THEME_NAME" "$NEW_IDX" "$WALLPAPER" > "$ACTIVE_DIR/wallpaper.toml"
    echo "Switched to wallpaper $NEW_IDX for theme '$THEME_NAME'"
else
    echo "Wallpaper not found: $WALLPAPER"
    exit 1
fi
